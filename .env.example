# Per Vercel o un hosting diverso da Netlify, endpoint pubblico di invio:
# VITE_CONTACT_ENDPOINT=https://esempio.it/api/contatti

# Opzionale: abilita esplicitamente Netlify Forms su un dominio personalizzato.
# Sui build Netlify l'abilitazione è automatica tramite NETLIFY=true.
# VITE_NETLIFY_FORMS=true
